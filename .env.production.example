# .env.production.example — variáveis de produção do MentorMatch.
# Copie para o painel do Vercel (Production). NUNCA commitar valores reais.

# --- Banco (Vercel Postgres / Neon) ---
POSTGRES_URL=

# --- Auth (NextAuth) ---
# AUTH_SECRET: sessão do site. MM_AUTH_SECRET: sessão isolada do MentorMatch.
# Gere com: openssl rand -base64 32  (valores DIFERENTES)
AUTH_SECRET=
MM_AUTH_SECRET=
AUTH_URL=https://aurimarnogueira.com.br
NEXT_PUBLIC_APP_URL=https://aurimarnogueira.com.br
AUTH_TRUST_HOST=true

# --- Email (Resend) — domínio verificado ---
RESEND_API_KEY=
RESEND_FROM=MentorMatch <noreply@aurimarnogueira.com.br>
RESEND_REPLY_TO=contato@aurimarnogueira.com.br

# --- Storage (uploads: logo, materiais, avatar) ---
BLOB_READ_WRITE_TOKEN=

# --- Seed de produção (super admin) ---
SUPER_ADMIN_EMAIL=espindolanogueira@yahoo.com.br
SUPER_ADMIN_PASSWORD=

# --- Observabilidade (opcional, recomendado) ---
# Webhook (Slack/Discord) que recebe alerta de erro/5xx/falha de email.
ALERT_WEBHOOK_URL=
# Sentry (ver DEPLOY.md §5).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- NUNCA em produção ---
# MM_EMAIL_CAPTURE: só dev/CI (captura email em memória p/ E2E). NAO setar em prod.
