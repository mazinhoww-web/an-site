# Resend (única dependência externa)
RESEND_API_KEY=
RESEND_FROM=Aurimar Nogueira <hello@aurimarnogueira.com.br>
RESEND_REPLY_TO=espindolanogueira@yahoo.com.br

# Site config
NEXT_PUBLIC_SITE_URL=https://aurimarnogueira.com.br
